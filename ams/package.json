    "dev": "node --watch backend/src/server.js",
    "demo": "node tools/serve.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
