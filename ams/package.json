{
  "name": "ams",
  "version": "0.1.0",
  "private": true,
  "description": "AMS — Airline Management System. Multi-tenant airline finance, fleet and procurement platform.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
