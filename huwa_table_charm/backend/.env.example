# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL for production, SQLite for dev)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=huwa_table_charm
DB_USER=huwa
DB_PASSWORD=huwa_secret

# Auth
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (optional — mock payments work without it)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# LLM — Charm Agent (optional — rule-based mode works without it)
LLM_API_KEY=
LLM_MODEL=gpt-4o

# Twilio SMS (optional — falls back to this if WhatsApp is not configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp — FREE (1000 messages/month via Meta Cloud API)
# Setup guide:
#   1. Go to https://developers.facebook.com/
#   2. Create a Meta Developer account (free)
#   3. Create an app > select "Business" type > add "WhatsApp" product
#   4. Go to WhatsApp > Quickstart > send a test message to get your PHONE_NUMBER_ID
#   5. Generate a permanent access token in WhatsApp > API Setup
#   6. The customer's phone number must include country code (e.g. "263771234567" for Zimbabwe)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
