{
  "name": "huwa-table-charm-backend",
  "version": "0.1.0",
  "private": true,
  "description": "HUWA TABLE CHARM - backend API (Express + TS + Knex)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/scripts/knex-cli.ts migrate",
    "migrate:rollback": "tsx src/scripts/knex-cli.ts rollback",
    "seed": "tsx src/scripts/knex-cli.ts seed",
    "catalog:petal-pearl": "tsx src/scripts/petal-pearl.ts",
    "db:reset": "tsx src/scripts/knex-cli.ts rollback --all && tsx src/scripts/knex-cli.ts migrate && tsx src/scripts/knex-cli.ts seed",
    "test": "vitest run",
    "lint": "echo \"no lint configured yet\" && exit 0",
    "catalog:release": "tsx src/scripts/release-catalog.ts",
    "admin:create": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@huwa/shared": "file:../shared",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "stripe": "^16.12.0",
    "twilio": "^6.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
